# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Product API & Website
PRODUCTS_API=https://sa-embroidery-backend.onrender.com/api/read/Products
ALLOWED_ORIGINS=https://saembroidery.com,https://www.saembroidery.com,http://localhost:3000

# Rate Limiting & Refresh
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=5
REFRESH_SECONDS=600

# Server Port (optional, defaults to 8000)
PORT=8000
